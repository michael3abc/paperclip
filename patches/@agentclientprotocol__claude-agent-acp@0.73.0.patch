diff --git a/dist/paperclip-pm-policy.js b/dist/paperclip-pm-policy.js
new file mode 100644
--- /dev/null
+++ b/dist/paperclip-pm-policy.js
@@ -0,0 +1,39 @@
+import { realpath } from "node:fs/promises";
+import path from "node:path";
+
+// This policy comes only from the admitted Runner context. It is independent
+// of Claude permission mode, user settings, prompts and tool annotations.
+export function paperclipPmToolPolicy(raw, cwd, mcpServers) {
+    if (!raw) return null;
+    const policy = JSON.parse(raw);
+    if (policy.kind !== "project_pm" || policy.version !== 2 || !Array.isArray(policy.readRoots)
+        || !policy.readRoots.length || policy.readRoots.some(root => typeof root !== "string" || !path.isAbsolute(root))
+        || Object.keys(policy).some(key => !["kind", "version", "readRoots"].includes(key))) {
+        throw new Error("Invalid Paperclip PM tool policy");
+    }
+    const bridge = mcpServers.paperclip;
+    if (bridge?.type !== "http" || bridge.url !== process.env.PAPERCLIP_ACPX_TASK_TOOL_BRIDGE_URL) {
+        throw new Error("PM tools require the authenticated Paperclip bridge");
+    }
+    const tools = ["Read", "Grep", "Glob"];
+    const deny = () => ({ hookSpecificOutput: { hookEventName: "PreToolUse", permissionDecision: "deny",
+        permissionDecisionReason: "PMs coordinate and review. Delegate execution to a Paperclip worker." } });
+    return { tools, async preToolUse(input) {
+        if (input.hook_event_name !== "PreToolUse") return deny();
+        // The authenticated bridge checks each operation and its resource scope.
+        if (input.tool_name.startsWith("mcp__paperclip__")) return {};
+        if (!tools.includes(input.tool_name)) return deny();
+        const args = input.tool_input;
+        const requested = input.tool_name === "Read" ? args?.file_path : (args?.path ?? cwd);
+        if (typeof requested !== "string" || requested.includes("\0")) return deny();
+        try {
+            const target = await realpath(path.resolve(cwd, requested));
+            for (const root of policy.readRoots) {
+                const canonical = await realpath(root);
+                const relative = path.relative(canonical, target);
+                if (relative === "" || (!relative.startsWith(".." + path.sep) && relative !== ".." && !path.isAbsolute(relative))) return {};
+            }
+        } catch { return deny(); }
+        return deny();
+    } };
+}
